# PrestigeHealth Provider Dashboard - environment template.
# Copy to .env (development) or .env.production and fill in real values.
# NEVER commit real .env / .env.production files.
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Google OAuth client ID (Google sign-in)
VITE_GOOGLE_CLIENT_ID=

# Backend API base URL (defaults to https://api.prestigedelta.com when unset)
VITE_BACKEND_BASE_URL=

# Realtime WebSocket base (optional)
VITE_BACKEND_WS_URL=

# Organization scope header value (optional override)
VITE_ORGANIZATION_DOMAIN=

# Agora RTC app id - display/fallback info only. Secure joins require the
# backend token endpoint; the app never joins a channel without a token.
VITE_AGORA_APP_ID=
